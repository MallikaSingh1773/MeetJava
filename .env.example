# Copy to .env and fill in. Every value has a sensible local default, so an
# empty .env still runs against a local PostgreSQL.

PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/meetjava
DB_USER=meetjava
DB_PASSWORD=meetjava

# Managed platforms supply one connection string instead of the three values
# above. Set this and leave DB_URL empty; the app converts it to JDBC at startup.
# DATABASE_URL=postgresql://user:password@host:5432/meetjava

# STUN gets two peers connected on most home networks.
STUN_URL=stun:stun.l.google.com:19302

# TURN is required for calls across the internet: two peers behind symmetric
# NAT can never reach each other with STUN alone. Free tier: metered.ca
# Accepts a comma separated list so one server can be offered over UDP and TCP.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
